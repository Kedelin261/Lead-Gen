{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadgen-pro",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadgen-pro-production",
      "database_id": "98615fbb-0b49-4f24-a835-91e4ef7f8ee9"
    }
  ],
  // Cloudflare Cron Trigger NOTE (Pages):
  // Cron triggers for Cloudflare Pages MUST be configured via the Cloudflare Dashboard:
  //   Pages → leadgen-pro → Settings → Functions → Cron Triggers
  //
  //   Add TWO cron expressions:
  //     "0 10 * * *"  →  10:00 AM UTC daily  (System Orchestrator §2)
  //     "0 14 * * *"  →  09:00 AM CST legacy engine fallback
  //
  // The scheduled() export in src/index.tsx handles BOTH triggers automatically.
  // POST /api/system/run-daily?force=true  →  manual override
}
