{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadgen-pro",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadgen-pro-production",
      "database_id": "98615fbb-0b49-4f24-a835-91e4ef7f8ee9"
    }
  ],
  // Cloudflare Cron Trigger NOTE (Pages):
  // Cron triggers for Cloudflare Pages are configured via the Cloudflare Dashboard:
  //   Pages → leadgen-pro → Settings → Functions → Cron Triggers
  //   Add cron expression: "0 14 * * *"  (daily 14:00 UTC = 9:00 AM CST)
  // The scheduled() export in src/index.tsx handles the trigger automatically.
}
