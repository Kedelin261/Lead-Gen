{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadgen-pro",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadgen-pro-production",
      "database_id": "98615fbb-0b49-4f24-a835-91e4ef7f8ee9"
    }
  ],
  // Cloudflare Cron Trigger: fires daily at 14:00 UTC (9:00 AM CST / Memphis local time)
  // This calls the scheduled() handler in the Worker entry point.
  // On Cloudflare Pages, cron triggers are configured via the dashboard
  // (Settings → Functions → Cron Triggers) using the same cron expression below.
  "triggers": {
    "crons": ["0 14 * * *"]
  }
}
